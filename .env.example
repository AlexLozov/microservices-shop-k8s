# Copy to .env and replace every value before starting Compose or Kubernetes.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
INTERNAL_KEY=replace-with-a-separate-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
RABBIT_USER=store
RABBIT_PASSWORD=replace-with-a-strong-rabbit-password
